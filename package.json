{
  "name": "epicgames-freegames-node",
  "version": "5.1.0",
  "description": "Use Epic's web APIs to login and redeem free games.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "vite-node src/index.ts",
    "start:ts": "vite-node src/index.ts",
    "entrypoint-config": "node dist/src/entrypoint-config.js",
    "build": "rimraf dist && tsc",
    "lint": "tsc --noEmit && eslint .",
    "docker:build": "docker build . -t charlocharlie/epicgames-freegames-node:latest --target deploy --build-arg=\"COMMIT_SHA=$(git rev-parse HEAD)\"",
    "docker:build-dev": "docker build . -t charlocharlie/epicgames-freegames:dev --target deploy",
    "docker:run": "docker run --rm -ti -v $(pwd)/config:/usr/app/config -p 3225:3225 -p 3001:3001 --init --ipc=host --security-opt seccomp=examples/seccomp_profile.json -e DEBUG=pw:browser* charlocharlie/epicgames-freegames-node:latest",
    "docker:buildx": "docker buildx build --platform=linux/arm64 . -t charlocharlie/epicgames-freegames-node:latest --target deploy",
    "docs": "vite-node scripts/generate-json-schema.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "filenamify": "^6.0.0",
    "fs-extra": "^11.2.0",
    "hashids": "^2.3.0",
    "jose": "^6.2.12",
    "json5": "^2.2.3",
    "localtunnel": "npm:@security-patched/localtunnel@^2.0.2-secpatched.5",
    "nodemailer": "^10.0.12",
    "open": "^10.0.4",
    "otpauth": "^9.2.2",
    "p-queue": "^8.0.1",
    "p-timeout": "^6.1.4",
    "patchright": "1.63",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "playwright": "1.63",
    "proxy-agent": "^8.0.1",
    "ps-list": "^8.1.1",
    "url-join": "^5.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@stylistic/eslint-plugin": "^3.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^22.15.33",
    "@types/object-assign-deep": "^0.4.3",
    "@types/url-join": "^4.0.3",
    "copyfiles": "^2.4.1",
    "eslint": "^9.31.0",
    "eslint-config-airbnb-extended": "^2.1.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-n": "^17.21.0",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-promise": "^7.2.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite-node": "^6.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/claabs/epicgames-freegames-node.git"
  },
  "author": "Charlie Laabs",
  "license": "MIT"
}
