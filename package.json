{
  "name": "epicgames-freegames-node",
  "version": "6.0.0",
  "description": "Use Epic's web APIs to login and redeem free games.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "start:ts": "node src/index.ts",
    "entrypoint-config": "node src/entrypoint-config.ts",
    "build": "tsc",
    "lint": "tsc && eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "fix-build-perms": "sudo chmod -R 775 ./config/users",
    "docker:build": "docker build . -t charlocharlie/epicgames-freegames-node:latest --build-arg=\"COMMIT_SHA=$(git rev-parse HEAD)\"",
    "docker:build-arm": "docker buildx build --platform=linux/arm64 --load -t charlocharlie/epicgames-freegames-node:arm64 .",
    "docker:run": "docker run --rm -ti --env-file=.env -v $(pwd)/config:/usr/app/config -p 3225:3225 -p 3001:3001 --init --ipc=host -e DEBUG=pw:browser* charlocharlie/epicgames-freegames-node:latest",
    "docker:run-arm": "docker run --rm -ti --env-file=.env --platform linux/arm64 -v $(pwd)/config:/usr/app/config -p 3225:3225 -p 3001:3001 --init --ipc=host -e DEBUG=pw:browser* charlocharlie/epicgames-freegames-node:arm64",
    "docker:run-legacy": "docker run --rm -ti -v $(pwd)/config:/usr/app/config -p 3225:3225 -p 3001:3001 -e DEBUG=pw:browser* charlocharlie/epicgames-freegames-node:latest",
    "docs": "node scripts/generate-json-schema.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cron-parser": "^5.10.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "filenamify": "^7.0.3",
    "fs-extra": "^11.4.1",
    "hashids": "^2.3.0",
    "jose": "^6.2.13",
    "json5": "^2.2.3",
    "localtunnel": "npm:@security-patched/localtunnel@^2.0.2-secpatched.5",
    "nodemailer": "^10.2.1",
    "open": "^11.0.4",
    "p-queue": "^10.0.0",
    "p-timeout": "^8.0.0",
    "patchright": "^1.64.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "1.64",
    "proxy-agent": "^8.0.2",
    "ps-list": "^9.0.0",
    "url-join": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node26": "^26.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^26.6.5",
    "@types/object-assign-deep": "^0.4.3",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/claabs/epicgames-freegames-node.git"
  },
  "author": "Charlie Laabs",
  "license": "MIT"
}
