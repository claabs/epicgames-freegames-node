    "testNotifiers": {
      "description": "When true, the process will send test notifications with a test redirect to example.com for all configured accounts. Be sure to disable this after a successful test. This test will block normal operation until the test link is accessed by one account. The test page can only be used once.",
      "example": true,
      "default": false,
      "env": "TEST_NOTIFIERS",
      "type": "boolean"
    },
    "skipVersionCheck": {
      "description": "Skip the call to api.github.com that checks for the latest version on launch",
      "example": true,
      "default": false,
      "env": "SKIP_VERSION_CHECK",
      "type": "boolean"
    },
    "browserLaunchTimeout": {
      "description": "In seconds, how long before a stuck Chromium process times out and gets restarted",
      "example": 30,
      "default": 15,
      "env": "BROWSER_LAUNCH_TIMEOUT",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "browserLaunchRetryAttempts": {
      "description": "How many times to attempt retry attempts to launch a browser after it times out",
      "example": 2,
      "default": 5,
      "env": "BROWSER_LAUNCH_RETRY_ATTEMPTS",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "browserNavigationTimeout": {
      "description": "How long in milliseconds the browser navigation will wait before timing out. 0 disables timeout (not recommended). See: https://playwright.dev/docs/api/class-page#page-set-default-navigation-timeout",
      "example": 120000,
      "default": 30000,
      "env": "BROWSER_NAVIGATION_TIMEOUT",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "countryCode": {
      "description": "The 2 character country code associated with your account. Used when determining if a game is blacklisted for your account. Commonly blacklisted countries: \"MO\",\"HK\",\"RU\",\"BY\",\"CN\"",
