      "default": "blacklisting is not checked",
      "env": "COUNTRY_CODE",
      "type": "string"
    },
    "deviceAuthClientId": {
      "description": "The Epic Games application client ID used for device code authorization to check your account's ownership of a game. List of available clients [here](https://github.com/Jaren8r/EpicClients).",
      "example": "b070f20729f84693b5d621c904fc5bc2 (Diesel - Dauntless)",
      "default": "98f7e42c2e3a4f86a74eb43fbb41ed39 (fortniteNewSwitchGameClient)",
      "env": "DEVICE_AUTH_CLIENT_ID",
      "type": "string"
    },
    "deviceAuthSecret": {
      "description": "The Epic Games application secret used for device code authorization to check your account's ownership of a game. List of available clients [here](https://github.com/Jaren8r/EpicClients).",
      "example": "HG@XE&TGCxEJsgT#&_p2]=aRo#~>=>+c6PhR)zXP (Diesel - Dauntless)",
      "default": "0a2449a2-001a-451e-afec-3e812901c4d7 (fortniteNewSwitchGameClient client secret)",
      "env": "DEVICE_AUTH_SECRET",
      "type": "string"
    },
    "deviceAuthPollRateSeconds": {
      "description": "After redirecting to a device authorization verification URL, how often the Epic Games API is polled for a successful login.",
      "example": 20,
      "default": 10,
      "env": "DEVICE_AUTH_POLL_RATE_SECONDS",
      "type": "integer",
      "minimum": 10,
      "maximum": 9007199254740991
    },
    "errorsDir": {
      "description": "The full path where the browser automation error screenshots will be output",
