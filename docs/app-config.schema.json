      "default": "${CONFIG_DIR}/errors",
      "env": "ERRORS_DIR",
      "type": "string"
    },
    "usersDir": {
      "description": "The full path where the browser automation error screenshots will be output",
      "example": "/users",
      "default": "${CONFIG_DIR}/users",
      "env": "USERS_DIR",
      "type": "string"
    },
    "notifyEula": {
